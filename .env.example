# Copy to .env. All shipped credentials are PUBLIC, local-only demo values.
APP_ENV=development
APP_NAME=EnterpriseFlow AI
LOG_LEVEL=INFO
POSTGRES_USER=enterpriseflow
POSTGRES_PASSWORD=local-demo-db-password
POSTGRES_DB=enterpriseflow
POSTGRES_ADMIN_PASSWORD=local-demo-admin-password
DATABASE_URL=postgresql+psycopg://enterpriseflow:local-demo-db-password@postgres:5432/enterpriseflow
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=enterpriseflow-documents
S3_ACCESS_KEY=local-demo-storage
S3_SECRET_KEY=local-demo-storage-password
S3_REGION=us-east-1
STORAGE_PATH=/srv/api/data
MAX_UPLOAD_MB=20
OIDC_ISSUER=http://localhost:8080/realms/enterpriseflow
OIDC_AUDIENCE=enterpriseflow-api
OIDC_CLIENT_ID=enterpriseflow-web
OIDC_CLIENT_SECRET=
OIDC_JWKS_URL=http://keycloak:8080/realms/enterpriseflow/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://keycloak:8080/realms/enterpriseflow/protocol/openid-connect/token
OIDC_AUTHORIZE_URL=http://localhost:8080/realms/enterpriseflow/protocol/openid-connect/auth
OIDC_LOGOUT_URL=http://localhost:8080/realms/enterpriseflow/protocol/openid-connect/logout
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-demo-keycloak-password
ENABLE_DEV_USERS=true
SESSION_COOKIE_SECRET=local-demo-cookie-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000
ALLOWED_ORIGINS=http://localhost:3000
JOBS_EAGER=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBEDDING_MODEL=text-embedding-3-small
# Reserved defense-in-depth flag; test doubles are injected only by tests.
ENABLE_FAKE_PROVIDER=false
# Development performs structural checks unless a ClamAV daemon is configured.
# Production requires a maintained scanner; never set REQUIRE_VIRUS_SCAN=false there.
REQUIRE_VIRUS_SCAN=false
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional operational tuning. Prices below are configurable ESTIMATES, not live rates.
SESSION_TTL_SECONDS=28800
EMBEDDING_DIMENSIONS=1536
RERANK_MODEL=
INPUT_COST_PER_MILLION=3
OUTPUT_COST_PER_MILLION=15
EXECUTION_BUDGET_USD=0.25
DAILY_BUDGET_USD=10
MODEL_TIMEOUT_SECONDS=60
INVOICE_APPROVAL_THRESHOLD=1000
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set only for host-side migration commands; Compose migrate already overrides DATABASE_URL.
MIGRATION_DATABASE_URL=
